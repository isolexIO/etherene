{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_address": {
      "type": "string",
      "description": "Address of the user who is following"
    },
    "following_address": {
      "type": "string",
      "description": "Address of the user being followed"
    }
  },
  "required": [
    "follower_address",
    "following_address"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": null
  }
}