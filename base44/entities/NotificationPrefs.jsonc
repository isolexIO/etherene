{
  "name": "NotificationPrefs",
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "Wallet address of the user"
    },
    "new_follower": {
      "type": "boolean",
      "default": true,
      "description": "Notify when someone follows me"
    },
    "new_reply": {
      "type": "boolean",
      "default": true,
      "description": "Notify when someone replies to my transmission"
    },
    "following_transmission": {
      "type": "boolean",
      "default": true,
      "description": "Notify when someone I follow posts a transmission"
    }
  },
  "required": [
    "address"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}