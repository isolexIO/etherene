{
  "name": "OracleInteraction",
  "type": "object",
  "properties": {
    "user_address": {
      "type": "string",
      "description": "Address of the user interacting with Oracle"
    },
    "topic": {
      "type": "string",
      "description": "Summary or topic of the interaction"
    },
    "type": {
      "type": "string",
      "enum": [
        "chat",
        "query",
        "insight"
      ],
      "default": "chat"
    }
  },
  "required": [
    "user_address"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}