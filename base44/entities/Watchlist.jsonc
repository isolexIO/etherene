{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "The wallet address being watched"
    },
    "note": {
      "type": "string",
      "description": "Optional note for the address"
    }
  },
  "required": [
    "address"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}