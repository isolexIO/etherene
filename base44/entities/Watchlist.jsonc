{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "The wallet address being watched"
    },
    "note": {
      "type": "string",
      "description": "Optional note for the address"
    }
  },
  "required": [
    "address"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}