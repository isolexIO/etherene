{
  "name": "Resonance",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The content of the resonance (comment)"
    },
    "transmission_id": {
      "type": "string",
      "description": "ID of the transmission being resonated with"
    },
    "author_address": {
      "type": "string",
      "description": "Wallet address of the author"
    }
  },
  "required": [
    "content",
    "transmission_id",
    "author_address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}