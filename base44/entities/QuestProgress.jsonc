{
  "name": "QuestProgress",
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "Wallet address of the user completing the quest"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the quest was completed (YYYY-MM-DD)"
    },
    "quest_key": {
      "type": "string",
      "description": "Unique identifier of the completed quest template"
    },
    "completed": {
      "type": "boolean",
      "default": true,
      "description": "Whether the quest is marked complete"
    },
    "mint_address": {
      "type": "string",
      "description": "On-chain SPL token mint address of the badge NFT issued for this completion"
    },
    "tx_signature": {
      "type": "string",
      "description": "Solana transaction signature of the verified on-chain badge mint"
    }
  },
  "required": [
    "address",
    "date",
    "quest_key"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}