{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_address": {
      "type": "string",
      "description": "Wallet address of the sender"
    },
    "recipient_address": {
      "type": "string",
      "description": "Wallet address of the recipient"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    }
  },
  "required": [
    "sender_address",
    "recipient_address",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}